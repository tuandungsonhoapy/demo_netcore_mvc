@{
    ViewBag.Title = "Login";
}
<h2>Đăng nhập</h2>
<form asp-action="Login" method="post">
    <div class="form-group mb-3">
        <ejs-textbox id="Username" placeholder="Tên đăng nhập" floatLabelType="Always"></ejs-textbox>
        <span class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <ejs-textbox id="Password" placeholder="Mật khẩu" type="password" floatLabelType="Always"></ejs-textbox>
        <span class="text-danger"></span>
    </div>

    <button type="submit">Login</button>
</form>
