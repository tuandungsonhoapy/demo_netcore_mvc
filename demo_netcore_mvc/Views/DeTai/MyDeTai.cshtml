@model demo_netcore_mvc.ViewModels.MyDeTaiViewModel
@using demo_netcore_mvc.Helper
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isSinhVien = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("SinhVien");
    var maSvClaim = User.FindFirst("MaSV")?.Value;
    int MaSV = 0;
    if (!string.IsNullOrEmpty(maSvClaim))
    {
        int.TryParse(maSvClaim, out MaSV);
    }
    var deTai = Model.DeTais;
}
<div>
        <h2>Đề tài đã đăng ký</h2>


    <form method="get" asp-action="MyDeTai" class="row g-3 mb-3">
        <input type="hidden" name="MaSV" value="@MaSV" />

        <div class="col-auto">
            <label asp-for=NamHoc" class="form-label">Năm học:</label>
            <select asp-for="NamHoc" asp-items="ViewBag.NamHocList" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-auto">
            <label asp-for=HocKy" class="form-label">Học kỳ:</label>
            <select asp-for="HocKy" asp-items="ViewBag.HocKyList" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="ExportExcel" asp-route-NamHoc="@Model.NamHoc" asp-route-HocKy="@Model.HocKy" class="btn btn-success">Xuất Excel</a>
            <a asp-action="ExportWord" asp-route-NamHoc="@Model.NamHoc" asp-route-HocKy="@Model.HocKy" class="btn btn-secondary">Xuất Word</a>
        </div>
    </form>

    <!-- Table -->
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Stt</th>
                <th>Mã đề tài</th>
                <th>Tên đề tài</th>
                <th>Kinh phí</th>
                <th>Nơi thực tập</th>
                <th>Tham gia</th>
                <th>Giảng viên</th>
                <th>Khoa</th>
                <th>HK/Năm học</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;

                var dtList = Model.DeTais;

                if (isSinhVien)
                {
                    dtList = Model.DeTais.Where(dt => dt.IsOpen).ToList();
                }
            }
            @foreach (var dt in dtList)
            {
                <tr>
                    <td>@stt</td>
                    <td>@dt.MaDT</td>
                    <td>@dt.TenDT</td>
                    <td>@dt.KinhPhi</td>
                    <td>@dt.NoiThucTap</td>
                    <td>@($"{dt.SoLuong}/{dt.ToiDa}")</td>
                    <td>@dt.GiangVien?.HoTenGV</td>
                    <td>@dt.GiangVien?.Khoa?.TenKhoa</td>
                    <td>@dt.HocKy/@dt.NamHoc</td>
                    <td>
                        @{
                            var isRegistered = dt.HuongDans.Any(hd => hd.MaSV == MaSV);

                            if (isRegistered && dt.IsOpen)
                            {
                                <form asp-action="Unregister" asp-controller="DeTai" method="post" style="display:inline">
                                    <input type="hidden" name="MaSV" value="@MaSV" />
                                    <input type="hidden" name="MaGV" value="@dt.GiangVien?.MaGV" />
                                    <input type="hidden" name="MaDT" value="@dt.MaDT" />
                                    <input type="hidden" name="returnAction" value="MyDeTai" />
                                    <input type="hidden" name="returnMaSV" value="@MaSV" />
                                    <button type="submit" class="btn btn-danger btn-sm">Hủy đăng ký</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>
