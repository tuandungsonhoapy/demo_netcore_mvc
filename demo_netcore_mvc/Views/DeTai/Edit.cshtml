@model demo_netcore_mvc.Models.DeTai

@{
    ViewData["Title"] = "Chỉnh sửa đề tài";
    var maGvClaim = User.FindFirst("MaGV")?.Value;
    int editedBy = 0;
    if (!string.IsNullOrEmpty(maGvClaim))
    {
        int.TryParse(maGvClaim, out editedBy);
    }
}

<h2>Chỉnh sửa đề tài</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MaDT" />
    <input type="hidden" name="editedBy" value="@editedBy" />
    <input type="hidden" asp-for="NguoiHuongDan" />

    <div class="form-group mb-3">
        <label asp-for="TenDT" class="form-label"></label>
        <input asp-for="TenDT" class="form-control" type="text" />
        <span asp-validation-for="TenDT" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NoiThucTap" class="form-label"></label>
        <input asp-for="NoiThucTap" class="form-control" />
        <span asp-validation-for="NoiThucTap" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="KinhPhi" class="form-label"></label>
        <input asp-for="KinhPhi" class="form-control" type="number" />
        <span asp-validation-for="KinhPhi" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="ToiDa" class="form-label"></label>
        <input asp-for="ToiDa" class="form-control" type="number" />
        <span asp-validation-for="ToiDa" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="NamHoc" class="form-label"></label>
        <input asp-for="NamHoc" class="form-control" />
        <span asp-validation-for="NamHoc" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="HocKy" class="form-label">Học Kỳ</label>
        <select asp-for="HocKy" class="form-control" asp-items="@new SelectList(new List<byte> { 1, 2, 3 }, Model.HocKy)">
            <option value="">-- Chọn học kỳ --</option>
        </select>
        <span asp-validation-for="HocKy" class="text-danger"></span>
    </div>

    <div class="form-group mb-3 form-check">
        <input asp-for="IsOpen" class="form-check-input" type="checkbox" />
        <label asp-for="IsOpen" class="form-check-label"></label>
        <span asp-validation-for="IsOpen" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a href="@ViewBag.ReturnUrl" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
