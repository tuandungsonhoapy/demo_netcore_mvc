@model demo_netcore_mvc.ViewModels.SinhVienViewModel
@using demo_netcore_mvc.Helper
@using Microsoft.AspNetCore.Mvc.Rendering

@await Component.InvokeAsync("Alert", new { type = TempData["AlertType"], message = TempData["AlertMessage"] })

<div>
    <h2>Quản lý thông tin sinh viên</h2>

    <form method="get" asp-action="Index" class="row g-3 mb-3">
        <div class="col-auto">
            <label asp-for=MaGV" class="form-label">Giảng viên hướng dẫn:</label>
            <select asp-for="MaGV" asp-items="ViewBag.GiangVienList" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-auto">
            <label asp-for=MaKhoa" class="form-label">Khoa:</label>
            <select asp-for="MaKhoa" asp-items="ViewBag.KhoaList" class="form-select">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="ExportExcel" asp-route-MaGV="@ViewData["MaGV"]" class="btn btn-success">Xuất Excel</a>
            <a asp-action="ExportWord" asp-route-MaGV="@ViewData["MaGv"]" class="btn btn-secondary">Xuất Word</a>
        </div>
    </form>

    <!-- Table -->
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Stt</th>
                <th>MSSV</th>
                <th>Họ tên</th>
                <th>Khoa</th>
                <th>Năm sinh</th>
                <th>Quê quán</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }
            @foreach(var sv in Model.SinhViens)
            {
                <tr>
                    <td>@stt</td>
                    <td>@sv.MaSV</td>
                    <td>@sv.HoTenSV</td>
                    <td>@sv.Khoa?.TenKhoa</td>
                    <td>@DateHelper.FormatDate(sv.NamSinh)</td>
                    <td>@sv.QueQuan</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@sv.MaSV" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@sv.MaSV" class="btn btn-warning btn-sm">Sửa</a>

                        <form id="deleteForm-@sv.MaSV" asp-action="Delete" asp-route-id="@sv.MaSV" method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>

                        <button class="btn btn-danger btn-sm"
                                onclick="if(confirm('Bạn có chắc chắn muốn xóa sinh viên này không?')) document.getElementById('deleteForm-@sv.MaSV').submit();">
                            Xóa
                        </button>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>
