    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model demo_netcore_mvc.ViewModels.GiangVienViewModel

<div>
    <h2>Quản lý thông tin giảng viên</h2>
    <form method="get" asp-action="Index" class="row g-3 mb-3">
        <div class="col-auto">
            <label asp-for=MaKhoa" class="form-label">Khoa:</label>
            <select asp-for="MaKhoa" asp-items="ViewBag.KhoaList" class="form-select select2">
                <option value="">-- Tất cả --</option>
            </select>
        </div>

        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Lọc</button>
            <a asp-action="ExportExcelSinhVienTheoGiangVien" asp-route-MaKhoa="@Model.MaKhoa" class="btn btn-success">Xuất Excel</a>
            <a asp-action="ExportWord" asp-route-MaKhoa="@Model.MaKhoa" class="btn btn-secondary">Xuất Word</a>
        </div>
    </form>
    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm giảng viên</a>
    </p>
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Stt</th>
                <th>Mã giảng viên</th>
                <th>Họ tên</th>
                <th>Lương</th>
                <th>Khoa</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gv in Model.GiangViens)
            {
                int index = Model.GiangViens.ToList().IndexOf(gv) + 1;
                <tr>
                    <td>@index</td>
                    <td>@gv.MaGV</td>
                    <td>@gv.HoTenGV</td>
                    <td>@gv.Luong.ToString("C")</td>
                    <td>@gv.Khoa?.TenKhoa</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@gv.MaGV" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@gv.MaGV" class="btn btn-warning btn-sm">Sửa</a>
                        <form id="deleteForm-@gv.MaGV" asp-action="Delete" asp-route-id="@gv.MaGV" method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                        </form>

                        <button class="btn btn-danger btn-sm"
                                onclick="if(confirm('Bạn có chắc chắn muốn xóa giảng viên này không?')) document.getElementById('deleteForm-@gv.MaGV').submit();">
                            Xóa
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
