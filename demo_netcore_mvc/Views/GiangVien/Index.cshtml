    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<demo_netcore_mvc.Models.GiangVien>

<div>
    <h2>Quản lý thông tin giảng viên</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Thêm giảng viên</a>
    </p>
    <table class="table table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Stt</th>
                <th>Mã giảng viên</th>
                <th>Họ tên</th>
                <th>Lương</th>
                <th>Khoa</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gv in Model)
            {
                int index = Model.ToList().IndexOf(gv) + 1;
                <tr>
                    <td>@index</td>
                    <td>@gv.MaGV</td>
                    <td>@gv.HoTenGV</td>
                    <td>@gv.Luong.ToString("C")</td>
                    <td>@gv.Khoa?.TenKhoa</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@gv.MaGV" class="btn btn-info btn-sm">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@gv.MaGV" class="btn btn-warning btn-sm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@gv.MaGV" class="btn btn-danger btn-sm"
                           onclick="return confirm('Bạn có chắc chắn muốn xóa giảng viên này không?');">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
