@model demo_netcore_mvc.ViewModels.GiangVienViewModel
@{
    ViewData["PageTitle"] = "Danh Sách Giảng Viên";
    var ej2Toolbar = new List<string>() { "ExcelExport" };
    ViewData["PageActionAddUrl"] = Url.Action("Create", "GiangVien");
}

<form method="get" asp-action="Index" class="row g-3 mb-3">
    <div class="col-2">
        <div id="default">
            <ejs-combobox value="@Model.MaKhoa" id="makhoa" dataSource="@ViewBag.Khoas" placeholder="Chọn khoa" popupHeight="220px" floatLabelType="Always">
                <e-combobox-fields value="MaKhoa" text="TenKhoa"></e-combobox-fields>
            </ejs-combobox>
        </div>
    </div>
        
    <div class="col-auto align-self-end">
        <ejs-button id="submit" type="submit" cssClass="e-primary" content="Lọc" iconCss="fa-solid fa-filter"></ejs-button>
    </div>
</form>

<ejs-grid id="grid" dataSource="@Model.GiangViens" allowPaging="true"
          allowGrouping="true" allowExcelExport="true" toolbar="@(ej2Toolbar)" toolbarClick="onToolbarClick"
>
    <e-grid-pagesettings pageSize="10"></e-grid-pagesettings>
    <e-grid-columns>
        <e-grid-column field="MaGV" headerText="Mã giảng viên" textAlign="Left"></e-grid-column>
        <e-grid-column field="HoTenGV" headerText="Họ tên" textAlign="Left"></e-grid-column>
        <e-grid-column field="Luong" headerText="Lương" textAlign="Left"></e-grid-column>
        <e-grid-column field="TenKhoa" headerText="Khoa" textAlign="Left"></e-grid-column>
        <e-grid-column template="#actionTemplate" width="220"></e-grid-column>
    </e-grid-columns>
</ejs-grid>

<script id="actionTemplate" type="text/x-template">
    <a href="/GiangVien/Details/${MaGV}" class="btn btn-sm btn-warning mx-1">
        <i class="fa-solid fa-eye"></i>
    </a>
    <a href="/GiangVien/Edit/${MaGV}" class="btn btn-sm btn-success mx-1">
        <i class="fa-solid fa-pencil"></i>
    </a>
    <button href="/GiangVien/Delete/${MaGV}" class="btn btn-sm btn-danger mx-1"
        onclick="deleteGiangVien(event, '${MaGV}')"
    >
        <i class="fa-solid fa-trash"></i>
    </button>
</script>

<script>
    function onToolbarClick(args) {
        if (args.item.id === "grid_excelexport") {
            var comboValue = document.getElementById("makhoa").ej2_instances[0].value;

            var url = '/GiangVien/ExportExcel';
            if (comboValue) {
                url += '?MaKhoa=' + comboValue;
            }

            window.location.href = url;
            args.cancel = true;
        }
    }

    function deleteGiangVien(event, maGV) {
        event.preventDefault();
        if (confirm('Bạn có chắc chắn muốn xóa giảng viên này không?')) {
            $.ajax({
                url: '/GiangVien/Delete/' + maGV,
                type: 'POST',
                success: function (result) {
                    location.reload();
                },
                error: function (err) {
                    alert('Đã xảy ra lỗi khi xóa giảng viên.');
                }
            });
        }
    }
</script>
