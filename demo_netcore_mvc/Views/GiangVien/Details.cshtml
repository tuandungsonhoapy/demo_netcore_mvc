@using demo_netcore_mvc.Helper
@model demo_netcore_mvc.Models.GiangVien

<h2>Chi tiết sinh viên</h2>

<div class="card p-3 mb-4">
    <dl class="row">
        <dt class="col-sm-3">Mã giảng viên</dt>
        <dd class="col-sm-9">@Model.MaGV</dd>

        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.HoTenGV</dd>

        <dt class="col-sm-3">Khoa</dt>
        <dd class="col-sm-9">@Model.Khoa?.TenKhoa</dd>

        <dt class="col-sm-3">Lương</dt>
        <dd class="col-sm-9">@Model.Luong.ToString("C")</dd>
    </dl>
</div>

<h4>Danh sách đề tài hướng dẫn</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã đề tài</th>
            <th>Tên đề tài</th>
            <th>Số lượng tham gia</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.DeTais != null && Model.DeTais.Any())
        {
            foreach (var dt in Model.DeTais)
            {
                <tr>
                    <td>@dt.MaDT</td>
                    <td>@dt.TenDT</td>
                    <td>@($"{dt?.SoLuong}/{dt?.ToiDa}")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Giảng viên chưa hướng dẫn đề tài nào</td>
            </tr>
        }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>