@model demo_netcore_mvc.ObjectData.AccountGiangVienData
@{
    ViewData["Title"] = "Thêm giảng viên";
}

<h2>Thêm giảng viên mới</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="HoTenGV" class="form-label"></label>
        <input asp-for="HoTenGV" class="form-control" />
        <span asp-validation-for="HoTenGV" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Luong" class="form-label"></label>
        <input asp-for="Luong" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Luong" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="MaKhoa" class="form-label">Khoa</label>
        <select asp-for="MaKhoa" class="form-control select2"
                asp-items="@ViewBag.KhoaList">
            <option value="">-- Chọn khoa --</option>
        </select>
        <span asp-validation-for="MaKhoa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
