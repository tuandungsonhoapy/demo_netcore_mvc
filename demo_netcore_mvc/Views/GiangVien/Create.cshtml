@model demo_netcore_mvc.ObjectData.AccountGiangVienData
@{
    ViewData["Title"] = "Thêm giảng viên";
}

<h2>Thêm giảng viên mới</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-3">
        <ejs-textbox id="username" placeholder="Tên đăng nhập" ejs-for="Username" floatLabelType="Always"></ejs-textbox>
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <ejs-textbox id="password" placeholder="Mật khẩu" ejs-for="Password" 
        floatLabelType="Always" type="password"></ejs-textbox>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <ejs-textbox id="hotengv" placeholder="Họ tên giảng viên" ejs-for="HoTenGV" floatLabelType="Always"></ejs-textbox>
        <span asp-validation-for="HoTenGV" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <ejs-numerictextbox id="luong" ejs-for="Luong" value="0" placeholder="Lương" floatLabelType="Always" min="0"></ejs-numerictextbox>
        <span asp-validation-for="Luong" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <div id="default">
            <ejs-combobox ejs-for="MaKhoa" floatLabelType="Always" id="country" datasource="@ViewBag.Khoas" placeholder="Chọn khoa" popupheight="220px">
                <e-combobox-fields value="MaKhoa" text="TenKhoa"></e-combobox-fields>
            </ejs-combobox>
        </div>
        <span asp-validation-for="MaKhoa" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
