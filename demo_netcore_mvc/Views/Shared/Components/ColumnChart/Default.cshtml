@model demo_netcore_mvc.Models.ColumnChart.ColumnChartModel
@using Syncfusion.EJ2

<div class="control-section" align="center">
    <ejs-chart id="columnContainer_@Guid.NewGuid().ToString()" load="columnChartLoad" title="@Model.Title" subTitle="@Model.SubTitle" axisLabelRender="columnChartAxisLabelRender" tooltipRender="columnChartTooltipRender">
        <e-chart-tooltipsettings enable="true" enableHighlight="true" header="<b>${point.x}</b>" format="${series.name}: <b>${point.y}</b>">
        </e-chart-tooltipsettings>
        <e-chart-legendsettings visible="true" enableHighlight="true" shapeWidth=9 shapeHeight=9>
        </e-chart-legendsettings>
        <e-chart-primaryxaxis valueType="@Syncfusion.EJ2.Charts.ValueType.Category" interval="1">
            <e-majorgridlines width="0"></e-majorgridlines>
            <e-majorticklines width="0"></e-majorticklines>
        </e-chart-primaryxaxis>
        <e-chart-primaryyaxis title="Số lượng"
                              minimum="@Model.PrimaryYAxis.Minimum"
                              maximum="@Model.PrimaryYAxis.Maximum"
                              interval="@Model.PrimaryYAxis?.Interval ?? 0">
            <e-majorticklines width="0"></e-majorticklines>
            <e-linestyle width="0"></e-linestyle>
        </e-chart-primaryyaxis>
        <e-chart-chartarea>
            <e-chartarea-border width="0"></e-chartarea-border>
            <e-chartarea-margin bottom=12></e-chartarea-margin>
        </e-chart-chartarea>
        <e-series-collection>
            @foreach (var series in Model.Series)
            {
                <e-series dataSource="@Model.DataSource" xName="@Model.XName" yName="@series.YName" name="@series.Name" columnSpacing="0.4" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Column" legendShape=Rectangle>
                    <e-series-cornerradius topLeft=4 topRight=4></e-series-cornerradius>
                </e-series>
            }
        </e-series-collection>
    </ejs-chart>
</div>

<script>
    function columnChartLoad(args) {
        args.chart.width = ej.base.Browser.isDevice ? "100%" : "75%";
        args.chart.primaryXAxis.labelIntersectAction = ej.base.Browser.isDevice ? 'None' : 'Trim';
        args.chart.primaryXAxis.labelRotation = ej.base.Browser.isDevice ? '-45' : '0';
    }

    function columnChartAxisLabelRender(args) {
        var value = parseInt(args.text.replace(/,/g, ''), 10);
        if (value >= 1000) {
            args.text = (value / 1000) + 'K';
        }
    }

    function columnChartTooltipRender(args) {
        if (args.text) {
            var value = args.point.y.toLocaleString('en-US');
            args.text = args.series.name + ': <b>' + value + '</b>';
        }
    }
</script>